# Sovereign Intelligence (Stock Sense) - Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit the real .env file.

# Environment Mode: development | production | testing
FLASK_ENV=development

# JWT Secret Key (REQUIRED in production - generate with `openssl rand -hex 32`)
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# CORS Allowed Origins (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Rate Limiting Storage URI (e.g. memory:// for single process, redis://localhost:6379/0 for production)
RATELIMIT_STORAGE_URI=memory://

# News API Key (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# Finnhub API Key (https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Google OAuth Client ID (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP for OTP Verification Emails
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# Telegram Notifications (optional)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id_here
